# Voice-Bridge – kopiere diese Datei nach .env und fülle die Werte aus.
# Alle Schlüssel beginnen mit VOICE_, damit sie nicht mit Shell-Variablen kollidieren.

# STT/TTS: OpenAI-kompatible Endpunkte (z. B. vLLM/Whisper, speaches/Piper).
# Läuft der Dienst auf einem anderen Rechner, hier dessen Adresse eintragen.
VOICE_STT_URL=http://127.0.0.1:8792/v1
VOICE_TTS_URL=http://127.0.0.1:8791/v1

# Bearer-Token beider Dienste. Niemals einchecken – .env ist ignoriert.
VOICE_API_KEY=CHANGE_ME

# Modelle und Stimme laut Server-Vertrag
VOICE_STT_MODEL=whisper-turbo
VOICE_STT_LANGUAGE=de
# Optionales Domänenvokabular für bessere Eigennamen/IPs
VOICE_STT_PROMPT=

VOICE_TTS_MODEL=speaches-ai/piper-de_DE-thorsten-medium
VOICE_TTS_VOICE=de_DE-thorsten-medium
VOICE_TTS_SPEED=1.0
# Sprechgrenze der Antwort in Zeichen (~20-25 s); danach kommt ein Hinweis
VOICE_TTS_MAX_CHARS=350
# strict = Echo-Sperre für Lautsprecher, off = Kopfhörer
VOICE_ECHO_GUARD=strict
# Wiedergabe: afplay (System) oder portaudio
VOICE_PLAYER=afplay
# Sprachausgabe (off = nur Transkript im Terminal)
VOICE_SPEAK=on
# Lautstärke des dumpfen Denk-Tons (0..1)
VOICE_SIGNAL_VOLUME=0.5
# Kurze Fortschritts-Ansagen während der Arbeit
VOICE_PROGRESS=on
VOICE_PROGRESS_INTERVAL_S=2.5

# OpenCode: automatisch über "opencode service status" + service.json.
# Nur für einen eigenen Server beide Werte setzen:
# VOICE_OPENCODE_URL=http://127.0.0.1:4096
# VOICE_OPENCODE_PASSWORD=
VOICE_OPENCODE_POLL_MS=250

# Arbeitsordner der Sitzung (wird beim ersten Lauf angelegt)
VOICE_SESSION_DIR=~/voice-workspace

# OpenCode-Agent (wird in Schritt 7 angelegt)
VOICE_AGENT=voice-orchestrator
# Modell für neue Sitzungen (leer = globales Standardmodell)
VOICE_MODEL=

# --- Audio / VAD (Standardwerte, nur bei Bedarf ändern) ---
# Whisper hat ein 448-Token-Fenster: max. ~28 s, daher Cap bei 25 s.
VOICE_SAMPLE_RATE=16000
VOICE_FRAME_MS=20
VOICE_VAD_AGGRESSIVENESS=2
VOICE_PRE_ROLL_MS=300
VOICE_SILENCE_MS=700
VOICE_MIN_SPEECH_MS=250
VOICE_MAX_UTTERANCE_S=25

# --- Barge-in (Unterbrechen während der Wiedergabe) ---
# Schwelle = max(Grundpegel, BARGE_MIN_RMS, Echo x Gain x BARGE_FACTOR)
VOICE_BARGE_FACTOR=1.8
# Sprache muss so lange durchgehend erkannt werden, bevor unterbrochen wird
VOICE_BARGE_MS=400
# Absolute Mindestschwelle gegen Rauschen
VOICE_BARGE_MIN_RMS=600
# Strengerer VAD nur fürs Unterbrechen (0..3; höher = strenger)
VOICE_BARGE_VAD=2
# Umgebungspegel vor der Wiedergabe messen (Millisekunden)
VOICE_AMBIENT_MS=250
# Mindestpegel der normalen Aufnahme (0 = aus; VAD regelt die Stille)
VOICE_RECORD_MIN_RMS=0

# Timeout für OpenCode-Anfragen in Sekunden
VOICE_REQUEST_TIMEOUT_S=120
